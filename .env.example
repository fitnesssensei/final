# Keitaro Admin API. Реальные значения — только в локальном .env (он в .gitignore).
# В этом файле значений нет: скопируйте его в .env и заполните.
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=

# Сущности трекера по умолчанию для создавателя кампаний.
KEITARO_DOMAIN_ID=
KEITARO_GROUP_ID=
KEITARO_SOURCE_ID=
KEITARO_GOOGLE_URL=https://www.google.com

# Клиент Admin API: таймаут одного запроса (секунды) и число повторов сверх первой
# попытки. 60 с — по факту живого прогона: `POST /streams` на инстансе не отвечал
# за 10 с, и создание кампании падало в 502. Понижать можно, если трекер быстрый.
KEITARO_TIMEOUT=60
KEITARO_RETRIES=1

# Локальная БД (журнал операций и кэш справочников).
# Значение по умолчанию — Postgres из docker compose (порт хоста 5433).
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5433/keitaro_wrapper
LOG_LEVEL=info

# Необязательная авторизация API и интерфейса (HTTP Basic).
# Пара задаётся только вместе: пустые значения — «авторизация выключена»,
# заданная половина пары — ошибка старта. /health и /ready открыты всегда.
AUTH_USER=
AUTH_PASSWORD=

# Обслуживание локальной БД.
# REFERENCE_CACHE_TTL — сколько секунд справочники селектов считаются свежими
# (0 — обновлять только пустой кэш или по кнопке «обновить»).
# OPERATIONS_RETENTION_DAYS — сколько дней хранить журнал операций
# (0 — хранить бессрочно; меньше срока возможного повтора запроса не ставьте).
REFERENCE_CACHE_TTL=900
OPERATIONS_RETENTION_DAYS=7
