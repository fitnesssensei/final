# Keitaro Admin API. Реальные значения — только в локальном .env (он в .gitignore).
# В этом файле значений нет: скопируйте его в .env и заполните.
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=

# Сущности трекера по умолчанию для создавателя кампаний.
KEITARO_DOMAIN_ID=
KEITARO_GROUP_ID=
KEITARO_SOURCE_ID=
KEITARO_GOOGLE_URL=https://www.google.com

# Локальная БД (журнал операций и кэш справочников).
# Значение по умолчанию — Postgres из docker compose (порт хоста 5433).
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5433/keitaro_wrapper
LOG_LEVEL=info
